---
// Selos das formas de pagamento aceitas no checkout do Stripe (rodapé, carrinho e embaixo dos botões de compra).
// Logos oficiais em public/img/pay (activemerchant/payment_icons, licença MIT).
const PAY = [
  { name: 'Visa', file: 'visa' },
  { name: 'Mastercard', file: 'mastercard' },
  { name: 'American Express', file: 'amex' },
  { name: 'Discover', file: 'discover' },
  { name: 'Apple Pay', file: 'apple-pay' },
  { name: 'Google Pay', file: 'google-pay' },
];
interface Props { center?: boolean; }
const { center = false } = Astro.props;
---
<ul class:list={['pay', { 'pay--center': center }]} aria-label="Accepted payment methods">
  {PAY.map((p) => <li><img src={`/img/pay/${p.file}.svg`} alt={p.name} title={p.name} width="38" height="24" loading="lazy" decoding="async" /></li>)}
</ul>
<style>
  .pay { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pay--center { justify-content: center; }
  .pay li { line-height: 0; }
  .pay img { display: block; width: 38px; height: 24px; border-radius: 3px; }
</style>
