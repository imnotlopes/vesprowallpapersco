---
// Comparador antes/depois (fotos reais do setup, com marca d'água). Arraste ou use as setas do teclado.
// O botão leva ao catálogo por padrão; a página do VESPRO™ Editions passa o checkout.
interface Props { href?: string; label?: string; checkout?: boolean; }
const { href = '/wallpapers', label = 'I want my screen to look like this', checkout = false } = Astro.props;
---
<section class="section">
  <div class="wrap center">
    <p class="eyebrow">Before / after</p>
    <h2>It makes more of a difference <em class="serif">than you'd think</em></h2>
    <p class="lead">Drag the slider: your everyday wallpaper on one side, a painting from the collection on the other.</p>
  </div>
  <div class="wrap">
    <div class="ba" data-compare role="slider" tabindex="0" aria-label="Compare before and after" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
      <img src="/img/home/antes-820.webp" alt="Laptop and monitor with the default Windows wallpaper" width="820" height="656" loading="lazy" decoding="async" />
      <div class="ba__after" data-compare-clip>
        <img src="/img/home/depois-820.webp" alt="The same laptop and monitor with an impasto oil painting wallpaper" width="820" height="656" loading="lazy" decoding="async" />
      </div>
      <span class="ba__tag ba__tag--l">BEFORE</span><span class="ba__tag ba__tag--r">AFTER</span>
      <div class="ba__handle" data-compare-handle><span>‹ ›</span></div>
    </div>
    <p class="center" style="margin-top:28px">{checkout
      ? <a class="btn" href={href} data-checkout data-track="ClickBuy" data-track-name="VESPRO™ Editions">{label}</a>
      : <a class="btn" href={href} data-track="ClickBrowse">{label}</a>}</p>
  </div>
</section>
<style>
  .ba { position: relative; max-width: 820px; margin: 32px auto 0; border-radius: 16px; overflow: hidden; cursor: ew-resize; touch-action: pan-y; user-select: none;
    box-shadow: 0 0 0 1px rgba(255,255,255,.14), 0 40px 80px -30px rgba(0,0,0,.8); }
  .ba img { display: block; width: 100%; height: auto; pointer-events: none; }
  .ba__after { position: absolute; inset: 0; clip-path: inset(0 0 0 50%); -webkit-clip-path: inset(0 0 0 50%); }
  .ba__tag { position: absolute; top: 14px; font-size: .7rem; letter-spacing: .18em; font-weight: 700; padding: 6px 10px; border-radius: 999px; background: rgba(6,10,16,.7); }
  .ba__tag--l { left: 14px; } .ba__tag--r { right: 14px; color: var(--gold); }
  .ba__handle { position: absolute; top: 0; bottom: 0; left: 50%; width: 3px; background: #fff; transform: translateX(-50%); pointer-events: none; }
  .ba__handle span { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 44px; height: 44px; border-radius: 50%; background: #fff; color: #060a10;
    display: flex; align-items: center; justify-content: center; font-weight: 700; box-shadow: 0 10px 25px rgba(0,0,0,.5); }
  .ba:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }
</style>
