---
// Topo no padrão de loja global. Computador: logo à esquerda, menu no centro ("Wallpapers" abre o menu grande),
// busca, conta e carrinho à direita. Celular: menu e busca à esquerda, logo no centro, carrinho à direita.
// Comportamento em public/js/nav.js (menu grande, menu do celular e busca); o carrinho é do cart.js.
import { NAV, SCREENS } from '../config';
import { SOCIAL } from '../data/social';
import { PRODUCTS, formatPrice } from '../../api/_lib/products.js';
import { WALLPAPERS, byCollection, preview, EDITIONS_LABEL, countLabel } from '../data/wallpapers';
const here = Astro.url.pathname.replace(/\.html$/, '');
const cols = Object.entries(PRODUCTS).filter(([, p]) => p.kind === 'pack')
  .map(([k, p]) => ({ name: p.collection, edition: p.edition, href: p.page, thumb: preview(byCollection(k)[0], 400),
    count: countLabel(byCollection(k).length), price: formatPrice(p.price), hd: !!p.hd }));
const atelier = PRODUCTS.complete;
const featThumb = preview(WALLPAPERS.find((w) => w.slug === 'tall-ship-open-sea') || WALLPAPERS[0], 800);
const explore = [
  { href: '/wallpapers', label: 'All wallpapers' },
  { href: '/oil-painting-wallpapers', label: 'Oil painting wallpapers' },
  { href: '/free-4k-wallpapers', label: 'Free wallpapers' },
];
const ICON = {
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/>',
  user: '<circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20c1.2-3.6 4-5.4 7.5-5.4s6.3 1.8 7.5 5.4"/>',
  bag: '<path d="M5.5 8h13l-1 12h-11l-1-12z"/><path d="M9 8a3 3 0 0 1 6 0"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  chevron: '<path d="m7 10 5 5 5-5"/>',
  right: '<path d="m10 7 5 5-5 5"/>',
  left: '<path d="m14 7-5 5 5 5"/>',
};
const svg = (k: keyof typeof ICON, s = 22) =>
  `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON[k]}</svg>`;
---
<header class="hdr" data-hdr>
  <div class="wrap hdr__in">
    <div class="hdr__start">
      <button type="button" class="hdr__icon" data-mnav-open aria-label="Open menu" aria-controls="mnav" aria-expanded="false" set:html={svg('menu')} />
      <button type="button" class="hdr__icon" data-search-open aria-label="Search" set:html={svg('search')} />
    </div>

    <a href="/" class="hdr__logo" aria-label="VESPRO home">
      <img src="/img/brand/vespro-logo-240.webp" alt="VESPRO" width="240" height="212" />
    </a>

    <nav class="hdr__nav" aria-label="Main">
      <ul>
        {NAV.map((n) => n.mega ? (
          <li class="hdr__has-mega">
            <button type="button" class="hdr__link" data-mega-toggle aria-expanded="false" aria-controls="mega">
              {n.label}<Fragment set:html={svg('chevron', 16)} />
            </button>
          </li>
        ) : (
          <li><a class="hdr__link" href={n.href} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="hdr__end">
      <button type="button" class="hdr__icon hdr__desk" data-search-open aria-label="Search" set:html={svg('search')} />
      <a class="hdr__icon hdr__desk" href="/get-my-links" aria-label="My downloads" title="My downloads" set:html={svg('user')} />
      <button type="button" class="hdr__icon hdr__cart" data-cart-open aria-label="Open cart">
        <Fragment set:html={svg('bag')} />
        <span class="hdr__count" data-cart-count hidden>0</span>
      </button>
    </div>
  </div>

  <div class="mega" id="mega" data-mega hidden>
    <div class="wrap mega__in">
      <div>
        <p class="mega__title">Collections</p>
        <ul class="mega__cols">
          {cols.map((c) => (
            <li><a href={c.href}>
              <img src={c.thumb} alt="" width="400" height="225" loading="lazy" decoding="async" />
              <span><i>VESPRO™</i><b>{c.name}</b><small>{c.edition}</small></span>
            </a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="mega__title">By screen</p>
        <ul class="mega__links">{SCREENS.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
        <p class="mega__title mega__title--gap">Explore</p>
        <ul class="mega__links">{explore.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
      </div>
      <a class="mega__feat" href="/collections/complete">
        <img src={featThumb} alt="" width="800" height="450" loading="lazy" decoding="async" />
        <span class="mega__feat-txt">
          <small>The Complete Collection</small>
          <b>VESPRO™ {atelier.collection}</b>
          <span>{EDITIONS_LABEL} wallpapers and every new edition · {formatPrice(atelier.price)}</span>
        </span>
      </a>
    </div>
  </div>
</header>

<div class="mnav" id="mnav" data-mnav hidden>
  <div class="mnav__overlay" data-mnav-close></div>
  <div class="mnav__sheet">
    <button type="button" class="mnav__x" data-mnav-close aria-label="Close menu" set:html={svg('close', 20)} />
    <aside class="mnav__panel" role="dialog" aria-modal="true" aria-label="Menu" tabindex="-1">
      <div class="mnav__views" data-mnav-views>
        <nav class="mnav__view" aria-label="Mobile">
          <ul class="mnav__main">
            <li><button type="button" class="mnav__big" data-mnav-sub aria-expanded="false">Wallpapers<span class="mnav__arrow" set:html={svg('right', 16)} /></button></li>
            {NAV.filter((n) => !n.mega).map((n) => <li><a class="mnav__big" href={n.href} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a></li>)}
            <li><a class="mnav__big" href="/get-my-links">My downloads</a></li>
          </ul>
        </nav>
        <div class="mnav__view mnav__view--sub" aria-label="Wallpapers">
          <button type="button" class="mnav__back" data-mnav-back set:html={`${svg('left', 18)}<span>Back</span>`} />
          <a class="mnav__feat" href="/collections/complete">
            <img src={featThumb} alt="" width="800" height="450" loading="lazy" decoding="async" />
            <span><small>Everything in one</small><b>VESPRO™ {atelier.collection}</b><em>{EDITIONS_LABEL} wallpapers · {formatPrice(atelier.price)}</em></span>
          </a>
          <p class="mnav__title">Collections · Edition 01</p>
          <ul class="mnav__cols">
            {cols.map((c) => (
              <li><a href={c.href}>
                <img src={c.thumb} alt="" width="400" height="225" loading="lazy" decoding="async" />
                <span><b>{c.name}</b><small>{c.count} wallpapers{c.hd ? ' · HD' : ''}</small></span>
                <em>{c.price}</em>
              </a></li>
            ))}
          </ul>
          <p class="mnav__title">By screen</p>
          <ul class="mnav__sub">
            {SCREENS.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
            <li><a href="/wallpapers">All wallpapers</a></li>
          </ul>
        </div>
      </div>
      <div class="mnav__foot">
        <ul class="mnav__social">
          {SOCIAL.map((s) => (
            <li><a href={s.url || undefined} target={s.url ? '_blank' : undefined} rel={s.url ? 'noopener' : undefined}
              aria-label={`VESPRO on ${s.name}`} title={s.handle || s.name}><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" set:html={s.svg} /></a></li>
          ))}
        </ul>
        <div class="mnav__bar">
          <a href="/contact">Contact</a>
          <a href="/get-my-links">My downloads</a>
        </div>
      </div>
    </aside>
  </div>
</div>

<div class="srch" data-search hidden role="dialog" aria-modal="true" aria-label="Search">
  <div class="srch__overlay" data-search-close></div>
  <div class="srch__panel">
    <div class="wrap srch__bar">
      <Fragment set:html={svg('search')} />
      <input type="search" data-search-input placeholder="Search wallpapers, collections or screens" aria-label="Search" autocomplete="off" />
      <button type="button" class="hdr__icon" data-search-close aria-label="Close search" set:html={svg('close')} />
    </div>
    <div class="wrap srch__res" data-search-results aria-live="polite"></div>
  </div>
</div>

<style is:global>
  /* global: os resultados da busca são criados pelo nav.js e não levam o escopo do Astro */
  /* No topo da página a barra é transparente; ao rolar ganha fundo escuro sólido, sem mudar as cores do logo e dos textos
     (nav.js põe .is-scrolled) */
  .hdr { position: sticky; top: 0; z-index: 30; background: transparent; border-bottom: 1px solid transparent;
    transition: background-color .3s ease, border-color .3s ease, box-shadow .3s ease; }
  .hdr.is-scrolled { background: #060a10; border-bottom-color: var(--line); box-shadow: 0 12px 30px -16px rgba(0, 0, 0, .8); }
  .hdr__in { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 76px; gap: 16px; }
  .hdr__start { display: none; gap: 4px; }
  .hdr__logo { display: flex; align-items: flex-start; text-decoration: none; justify-self: start; }
  .hdr__logo img { height: 46px; width: auto; }
  .hdr__nav ul { display: flex; gap: 36px; list-style: none; margin: 0; padding: 0; }
  .hdr__link { display: inline-flex; align-items: center; gap: 4px; background: none; border: 0; padding: 12px 0; cursor: pointer;
    font: 500 0.98rem/1 var(--sans); color: var(--fg); text-decoration: none; white-space: nowrap; }
  .hdr__link:hover, .hdr__link[aria-current='page'], .hdr__link[aria-expanded='true'] { color: var(--gold); }
  .hdr__link svg { transition: transform .2s; }
  .hdr__link[aria-expanded='true'] svg { transform: rotate(180deg); }
  .hdr__end { display: flex; align-items: center; justify-content: flex-end; gap: 6px; }
  .hdr__icon { position: relative; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: none; border: 0;
    color: var(--fg); cursor: pointer; text-decoration: none; }
  .hdr__icon:hover { color: var(--gold); background: rgba(255, 255, 255, .05); }
  .hdr__count { position: absolute; top: 3px; right: 2px; min-width: 17px; height: 17px; padding: 0 4px; border-radius: 9px; background: var(--gold);
    color: #060a10; font-size: .66rem; font-weight: 700; display: grid; place-items: center; }
  .hdr__count[hidden] { display: none; }

  /* menu grande */
  .mega { position: absolute; left: 0; right: 0; top: 100%; background: #0a0f15; border-bottom: 1px solid var(--line); box-shadow: 0 30px 60px rgba(0, 0, 0, .55); }
  .mega[hidden] { display: none; }
  .mega__in { display: grid; grid-template-columns: 2.3fr .9fr 1fr; gap: 36px; padding: 30px 0 34px; }
  .mega__title { font-size: .7rem; letter-spacing: .18em; text-transform: uppercase; font-weight: 600; color: var(--muted); margin: 0 0 14px; }
  .mega__title--gap { margin-top: 26px; }
  .mega__cols { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px 12px; }
  .mega__cols a { display: flex; align-items: center; gap: 12px; text-decoration: none; padding: 6px; border-radius: 10px; }
  .mega__cols a:hover { background: rgba(255, 255, 255, .04); }
  .mega__cols img { width: 60px; aspect-ratio: 16/10; object-fit: cover; border-radius: 6px; flex-shrink: 0; }
  .mega__cols i { display: block; font-style: normal; font-size: .66rem; letter-spacing: .12em; color: var(--muted); }
  .mega__cols b { display: block; font-weight: 600; font-size: .92rem; color: var(--fg); }
  .mega__cols small { display: block; font-size: .74rem; color: var(--gold); }
  .mega__links { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .mega__links a { color: var(--soft); text-decoration: none; font-size: .95rem; }
  .mega__links a:hover { color: var(--gold); }
  .mega__feat { position: relative; display: block; border-radius: 14px; overflow: hidden; text-decoration: none; align-self: start;
    box-shadow: 0 0 0 1px rgba(217, 184, 120, .45); }
  .mega__feat img { width: 100%; aspect-ratio: 16/11; object-fit: cover; transition: transform .5s; }
  .mega__feat:hover img { transform: scale(1.04); }
  .mega__feat-txt { position: absolute; inset: auto 0 0 0; padding: 40px 18px 16px; background: linear-gradient(transparent, rgba(4, 7, 12, .92)); display: grid; gap: 2px; }
  .mega__feat-txt small { font-size: .66rem; letter-spacing: .18em; text-transform: uppercase; color: var(--gold); font-weight: 600; }
  .mega__feat-txt b { font-size: 1.25rem; font-weight: 600; color: #fff; }
  .mega__feat-txt span { font-size: .82rem; color: var(--soft); }

  /* menu do celular: painel que sobe de baixo, com o "x" redondo flutuando acima; "Wallpapers" abre o submenu de coleções */
  .mnav { position: fixed; inset: 0; z-index: 60; }
  .mnav[hidden] { display: none; }
  .mnav__overlay { position: absolute; inset: 0; background: rgba(0, 0, 0, .62); backdrop-filter: blur(2px); opacity: 0; transition: opacity .25s; }
  .mnav__sheet { position: absolute; left: 8px; right: 8px; bottom: 0; height: min(76vh, 640px); display: flex; flex-direction: column;
    transform: translateY(105%); transition: transform .3s cubic-bezier(.2, .8, .2, 1); }
  .mnav__x { position: absolute; top: -64px; left: 50%; translate: -50% 0; width: 48px; height: 48px; border-radius: 50%; border: 0; cursor: pointer;
    display: grid; place-items: center; color: #10151c; background: #fff; box-shadow: 0 8px 24px rgba(0, 0, 0, .45); }
  .mnav__panel { flex: 1; min-height: 0; display: flex; flex-direction: column; background: #0b1118; border-radius: 18px 18px 0 0; outline: none; overflow: hidden;
    box-shadow: 0 -1px 0 rgba(255, 255, 255, .08), 0 -30px 60px rgba(0, 0, 0, .5); }
  .mnav.is-open .mnav__overlay { opacity: 1; }
  .mnav.is-open .mnav__sheet { transform: none; }
  .mnav__views { position: relative; flex: 1; min-height: 0; display: grid; grid-template-columns: 100% 100%; transition: transform .28s ease; }
  .mnav__views.is-sub { transform: translateX(-100%); }
  .mnav__view { min-height: 0; overflow-y: auto; padding: 22px 24px 18px; overscroll-behavior: contain; }
  .mnav__main { list-style: none; margin: 0; padding: 0; }
  .mnav__main li + li { border-top: 1px solid var(--line); }
  .mnav__big { display: flex; width: 100%; justify-content: space-between; align-items: center; padding: 13px 0; background: none; border: 0; cursor: pointer;
    font: 600 1.3rem/1.25 var(--sans); letter-spacing: -0.01em; color: var(--fg); text-decoration: none; text-align: left; }
  .mnav__big:hover, .mnav__big[aria-current='page'] { color: var(--gold); }
  .mnav__arrow { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: rgba(255, 255, 255, .1); color: var(--fg); }
  .mnav__back { display: inline-flex; align-items: center; gap: 4px; margin: -6px 0 14px -6px; padding: 6px; background: none; border: 0; cursor: pointer;
    color: var(--soft); font: 600 .9rem var(--sans); }
  .mnav__title { font-size: .68rem; letter-spacing: .18em; text-transform: uppercase; font-weight: 600; color: var(--muted); margin: 0 0 10px; }
  .mnav__cols { list-style: none; margin: 0 0 22px; padding: 0; }
  .mnav__cols li + li { border-top: 1px solid var(--line); }
  .mnav__cols a { display: flex; align-items: center; gap: 14px; padding: 10px 0; text-decoration: none; }
  .mnav__cols img { width: 64px; aspect-ratio: 16/10; object-fit: cover; border-radius: 6px; flex-shrink: 0; box-shadow: 0 0 0 1px rgba(255, 255, 255, .1); }
  .mnav__cols span { flex: 1; min-width: 0; }
  .mnav__cols b { display: block; font-weight: 600; font-size: .98rem; line-height: 1.25; color: var(--fg); }
  .mnav__cols small { display: block; font-size: .78rem; color: var(--muted); margin-top: 2px; }
  .mnav__cols em { font-style: normal; font-weight: 600; font-size: .9rem; color: var(--soft); }
  .mnav__cols a:hover b { color: var(--gold); }
  .mnav__feat { position: relative; display: block; margin-bottom: 24px; border-radius: 12px; overflow: hidden; text-decoration: none;
    box-shadow: 0 0 0 1px rgba(217, 184, 120, .45); }
  .mnav__feat img { width: 100%; aspect-ratio: 16/7; object-fit: cover; display: block; }
  .mnav__feat span { position: absolute; inset: auto 0 0 0; padding: 26px 14px 12px; display: grid; background: linear-gradient(transparent, rgba(4, 7, 12, .92)); }
  .mnav__feat small { font-size: .62rem; letter-spacing: .18em; text-transform: uppercase; color: var(--gold); font-weight: 600; }
  .mnav__feat b { font-weight: 600; color: #fff; }
  .mnav__feat em { font-style: normal; font-size: .78rem; color: var(--soft); }
  .mnav__sub { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .mnav__sub a { color: var(--soft); text-decoration: none; font-size: .95rem; }
  .mnav__sub a:hover { color: var(--gold); }
  .mnav__foot { padding: 0 24px calc(14px + env(safe-area-inset-bottom)); }
  .mnav__social { list-style: none; margin: 0 0 0 -10px; padding: 10px 0 12px; display: flex; gap: 4px; }
  .mnav__social a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; color: var(--fg); }
  .mnav__social a[href]:hover { color: var(--gold); }
  .mnav__bar { display: flex; justify-content: space-between; padding-top: 14px; border-top: 1px solid var(--line); }
  .mnav__bar a { font-weight: 600; font-size: .92rem; color: var(--fg); text-decoration: none; }

  /* busca */
  .srch { position: fixed; inset: 0; z-index: 70; }
  .srch[hidden] { display: none; }
  .srch__overlay { position: absolute; inset: 0; background: rgba(0, 0, 0, .65); }
  .srch__panel { position: relative; background: #0a0f15; border-bottom: 1px solid var(--line); padding-bottom: 18px; max-height: 85vh; overflow-y: auto; }
  .srch__bar { display: flex; align-items: center; gap: 12px; min-height: 76px; color: var(--muted); }
  .srch__bar input { flex: 1; min-width: 0; background: none; border: 0; outline: none; color: var(--fg); font: 400 1.15rem var(--sans); padding: 10px 0; }
  .srch__bar input::-webkit-search-cancel-button { display: none; }
  .srch__res { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 8px 18px; }
  .srch__res p { grid-column: 1 / -1; color: var(--muted); font-size: .9rem; margin: 4px 0 8px; }
  .srch__item { display: flex; align-items: center; gap: 12px; padding: 8px; border-radius: 10px; text-decoration: none; }
  .srch__item:hover, .srch__item:focus { background: rgba(255, 255, 255, .05); outline: none; }
  .srch__item img, .srch__ph { width: 72px; aspect-ratio: 16/10; object-fit: cover; border-radius: 6px; flex-shrink: 0; background: rgba(255, 255, 255, .06); }
  .srch__item b { display: block; font-weight: 600; font-size: .9rem; color: var(--fg); line-height: 1.3; }
  .srch__item small { font-size: .74rem; color: var(--gold); }

  @media (max-width: 960px) {
    .hdr__in { min-height: 64px; }
    .hdr__start { display: flex; justify-self: start; }
    .hdr__logo { justify-self: center; }
    .hdr__logo img { height: 40px; }
    .hdr__nav, .hdr__desk { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .mnav__sheet, .mnav__overlay, .mnav__views { transition: none; } }
</style>
