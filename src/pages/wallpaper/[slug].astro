---
// Página de cada obra: nome buscável, prévia com marca d'água, texto próprio, ficha técnica,
// obras do mesmo tema e metadados de licença (selo "Licensable" no Google Imagens).
import Base from '../../layouts/Base.astro';
import WallGrid from '../../components/WallGrid.astro';
import Gallery from '../../components/Gallery.astro';
import ProductPanel from '../../components/ProductPanel.astro';
import { PRODUCTS } from '../../../api/_lib/products.js';
import { SITE } from '../../config';
import { WALLPAPERS, THEMES, preview, byTheme, byCollection, themeIndexable } from '../../data/wallpapers';
import type { Wallpaper } from '../../data/wallpapers';

export function getStaticPaths() {
  return WALLPAPERS.map((w) => ({ params: { slug: w.slug }, props: { w } }));
}
const { w } = Astro.props as { w: Wallpaper };
const theme = THEMES[w.theme];
const pack = w.collection;   // null = obra que só vem no VESPRO™ Editions
const res = w.hd ? 'HD' : '4K';
const related = byTheme(w.theme).filter((x) => x.slug !== w.slug).slice(0, 6);
const more = related.length < 3 ? WALLPAPERS.filter((x) => x.theme !== w.theme).slice(0, 6 - related.length) : [];
const path = `/wallpaper/${w.slug}`;
// galeria: a obra primeiro, depois outras da mesma coleção (ou do mesmo tema, se for exclusiva do Editions)
const siblings = (pack ? byCollection(pack) : byTheme(w.theme)).filter((x) => x.slug !== w.slug).slice(0, 7);
const gallery = [w, ...siblings].map((x) => ({ src: preview(x), thumb: preview(x, 400), alt: `${x.title}, oil painting wallpaper preview` }));
const eyebrow = `${theme.name} wallpaper · ${pack ? `${PRODUCTS[pack].collection} ${PRODUCTS[pack].edition}` : 'Editions exclusive'}`;
const page = {
  path,
  title: `${w.title}: Oil Painting Wallpaper in ${res} | VESPRO™`,
  description: `${w.description} Impasto oil painting wallpaper in ${res} for desktop and laptop.`.slice(0, 158),
  keyword: `${w.title.toLowerCase()} wallpaper`,
  indexable: true,
  priority: 0.6,
};
const themeLink = themeIndexable(w.theme) ? `/wallpapers/${w.theme}` : '/wallpapers';
const abs = (p: string) => new URL(p, SITE.url).href;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'ImageObject',
    name: `${w.title}, oil painting wallpaper`, description: w.description,
    contentUrl: abs(preview(w)), thumbnailUrl: abs(preview(w, 400)),
    creator: { '@type': 'Organization', name: SITE.name }, creditText: SITE.name,
    copyrightNotice: `© ${SITE.name}`, license: abs('/license'), acquireLicensePage: abs('/license'),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Wallpapers', item: abs('/wallpapers') },
      { '@type': 'ListItem', position: 2, name: `${theme.name} wallpapers`, item: abs(themeLink) },
      { '@type': 'ListItem', position: 3, name: w.title, item: abs(path) },
    ],
  },
];
---
<Base page={page} pageType="wallpaper" image={preview(w)} jsonLd={jsonLd}>
  <article class="section pdp">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/wallpapers">Wallpapers</a> / <a href={themeLink}>{theme.name} wallpapers</a> / <span>{w.title}</span>
      </nav>
      <div class="pdp__grid">
        <Gallery items={gallery} note="Previews are watermarked and downscaled. Your download is full resolution, without watermark." />
        <ProductPanel eyebrow={eyebrow} pack={pack} packCount={pack ? byCollection(pack).length : 0} back={path} sub={w.description}>
          <h1 slot="title">{w.title}</h1>
          {pack && <p class="incl">This painting comes in <a href={PRODUCTS[pack].page}>{PRODUCTS[pack].name}</a>.</p>}
          <div class="pdp__acc">
            <details open><summary>Specs</summary>
              <ul class="specs">
                <li><b>Desktop & laptop:</b> {w.hd ? 'HD, 1672 × 941 (16:9)' : '4K, 3840 × 2160 (16:9)'}</li>
                <li><b>Works on:</b> Windows PCs, MacBook and iMac, monitors</li>
                <li><b>Style:</b> impasto oil painting, visible brushstrokes</li>
              </ul></details>
            <details><summary>License</summary>
              <p>Personal use on your own devices. No reselling or sharing. <a href="/license">Read the license</a>.</p></details>
            <details><summary>Guarantee</summary>
              <p>Not in love with it? Email us within 14 days and we refund you in full. <a href="/refunds">Refund policy</a>.</p></details>
          </div>
          <p class="muted free">Not ready to buy? <a href="/free-4k-wallpapers" data-track="ClickFreePack">Get 12 free wallpapers</a> first.</p>
        </ProductPanel>
      </div>
    </div>
  </article>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <h2 style="font-size:1.6rem">More {theme.name.toLowerCase()} wallpapers</h2>
      <WallGrid items={[...related, ...more]} />
      <p style="margin-top:20px"><a href={themeLink}>See all {theme.name.toLowerCase()} wallpapers →</a></p>
    </div>
  </section>
</Base>

<style>
  .crumbs { font-size: .85rem; color: var(--muted); margin-bottom: 6px; }
  .crumbs a { color: var(--muted); display: inline-block; padding: 10px 0; }
  .incl { font-size: .88rem; color: var(--muted); margin: 14px 0 0; text-align: center; }
  .incl a, .free a { color: var(--gold); }
  .specs { padding-left: 1.1em; margin: 0 0 16px; }
  .specs li { color: var(--soft); margin-bottom: 6px; font-size: .92rem; }
  .specs b { color: var(--fg); font-weight: 600; }
  .free { font-size: .88rem; margin-top: 18px; }
</style>
