---
// Home no desenho da landing VESPRO: hero, frase, antes/depois, favoritas, temas, comunidade, pack grátis e FAQ.
// A grade de obras e os temas ficam por SEO (links internos para as páginas que queremos ranquear).
import Base from '../layouts/Base.astro';
import WallGrid from '../components/WallGrid.astro';
import Hero from '../components/home/Hero.astro';
import WordReveal from '../components/home/WordReveal.astro';
import BeforeAfter from '../components/home/BeforeAfter.astro';
import Community from '../components/home/Community.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import { PAGES } from '../data/pages';
import { WALLPAPERS, THEMES, byTheme, themeIndexable, preview } from '../data/wallpapers';
import { PRODUCTS, formatPrice } from '../../api/_lib/products.js';
const themes = Object.values(THEMES).filter((t) => themeIndexable(t.key));
const picks = ['tall-ship-open-sea', 'snow-angel', 'galloping-horses', 'shark-school-of-fish', 'lake-house-golden-hour', 'couple-under-street-lamp']
  .map((s) => WALLPAPERS.find((w) => w.slug === s)!).filter(Boolean);
---
<Base page={PAGES.home} pageType="home" footerNote="Real customer conversations, translated from Portuguese. Some setup photos are for illustration.">
  <Hero />
  <WordReveal />
  <BeforeAfter />

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">A few of our favorites</p>
      <h2>Fresh off the <em class="serif">easel</em></h2>
      <WallGrid items={picks} />
      <p style="margin-top:20px"><a href="/wallpapers">Browse the wallpapers →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Shop by theme</p>
      <h2>Pick a <em class="serif">mood</em></h2>
      <div class="themes">
        {themes.map((t) => (
          <a class="themes__item" href={`/wallpapers/${t.key}`}>
            <img src={preview(byTheme(t.key)[0], 400)} alt="" loading="lazy" width="400" height="225" />
            <span>{t.name} wallpapers <small class="muted">· {byTheme(t.key).length}</small></span>
          </a>
        ))}
      </div>
      <p style="margin-top:24px"><a class="btn btn--ghost" href="/collections/complete">Get VESPRO™ Editions, every wallpaper for {formatPrice(PRODUCTS.complete.price)}</a></p>
    </div>
  </section>

  <Community />

  <section class="section">
    <div class="wrap center">
      <p class="eyebrow">VESPRO™ First Strokes</p>
      <h2>Start with <em class="serif">12 free</em> wallpapers</h2>
      <p class="lead">Full-resolution oil painting wallpapers for your desktop, delivered to your inbox.</p>
      <a class="btn" href="/free-4k-wallpapers" data-track="ClickFreePack">Get the free pack</a>
    </div>
  </section>

  <HomeFaq />
  <script is:inline src="/js/home.js" defer></script>
</Base>

<style>
  .themes { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; margin-top: 24px; }
  .themes__item { display: flex; flex-direction: column; gap: 8px; text-decoration: none; }
  .themes__item img { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: 12px; box-shadow: 0 0 0 1px rgba(255,255,255,.12); }
  .themes__item span { font-weight: 600; color: var(--soft); }
  .themes__item:hover span { color: var(--gold); }
</style>
