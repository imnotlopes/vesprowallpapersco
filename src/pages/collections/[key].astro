---
// Página de cada coleção nova (Signature, Sporting, Shadows). As 6 primeiras usam a página do tema;
// o VESPRO™ Editions tem página própria (complete.astro). Mostra até 24 obras para manter a curiosidade.
import Base from '../../layouts/Base.astro';
import WallGrid from '../../components/WallGrid.astro';
import Gallery from '../../components/Gallery.astro';
import ProductPanel from '../../components/ProductPanel.astro';
import { PRODUCTS } from '../../../api/_lib/products.js';
import { byCollection, preview, EDITIONS_LABEL, countLabel } from '../../data/wallpapers';

export function getStaticPaths() {
  return Object.entries(PRODUCTS)
    .filter(([, p]) => p.kind === 'pack' && p.page.startsWith('/collections/'))
    .map(([key, p]) => ({ params: { key: p.page.split('/').pop() }, props: { key } }));
}
const { key } = Astro.props;
const p = PRODUCTS[key];
const items = byCollection(key);
const count = countLabel(items.length);
const shown = items.slice(0, 24);
const res = p.hd ? 'HD' : '4K';
const gallery = items.slice(0, 10).map((w, i) => ({ src: preview(w), thumb: preview(w, 400), alt: `${w.title}, ${p.collection} oil painting wallpaper ${i + 1}` }));
const page = {
  path: p.page,
  title: `${p.name.replace(/ /g, ' ')}: ${count} Oil Painting Wallpapers in ${res} | VESPRO™`.replace('VESPRO™ ', ''),
  description: `${p.blurb} ${count} impasto oil painting wallpapers for desktop and laptop. One-time payment, instant download.`.slice(0, 158),
  keyword: `${p.collection.toLowerCase()} wallpapers`,
  indexable: true,
  priority: 0.8,
};
const faq = [
  { q: `What is in ${p.name.replace(/ /g, ' ')}?`, a: `${count} oil painting wallpapers in ${res === 'HD' ? 'HD (1672 × 941)' : '4K (3840 × 2160)'}, delivered as one download right after checkout.` },
  { q: 'Is it a one-time payment?', a: 'Yes. Pay once and keep the files for life.' },
  { q: 'Is it part of VESPRO™ Editions?', a: `Yes. VESPRO™ Editions includes this collection, every other collection and exclusive paintings, ${EDITIONS_LABEL} wallpapers in total, plus every new edition.` },
  { q: 'What if I don\'t like them?', a: 'Email us within 14 days and we refund you in full.' },
];
---
<Base page={page} pageType="collection" image={preview(items[0])}>
  <section class="section pdp">
    <div class="wrap pdp__grid">
      <Gallery items={gallery} note="Previews are watermarked and downscaled. Your download is full resolution, without watermark." />
      <ProductPanel eyebrow={`VESPRO™ Collection · ${count} wallpapers`} pack={key} packCount={items.length} back={p.page} sub={p.blurb}>
        <h1 slot="title">{p.collection} <em class="serif">{p.edition}</em></h1>
        <div class="pdp__acc">
          <details open><summary>What you get</summary>
            <p>{count} impasto oil painting wallpapers in {res === 'HD' ? 'HD, 1672 × 941' : '4K, 3840 × 2160'} (16:9), for Windows PCs, MacBook, iMac and external monitors. One download link, right after checkout.</p></details>
          <details><summary>License</summary>
            <p>Personal use on your own devices. No reselling or sharing. <a href="/license">Read the license</a>.</p></details>
          <details><summary>Guarantee</summary>
            <p>Not in love with them? Email us within 14 days and we refund you in full. <a href="/refunds">Refund policy</a>.</p></details>
        </div>
      </ProductPanel>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <p class="eyebrow">Inside the collection</p>
      <h2>Every painting in <em class="serif">{p.collection}</em></h2>
      <WallGrid items={shown} />
      {items.length > shown.length && (
        <p class="center col-more">{countLabel(items.length - shown.length)} more paintings inside the collection</p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap faqw">
      <h2 class="center">Questions</h2>
      {faq.map((f) => (<details class="faqi"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>
  </section>
</Base>

<style>
  .col-more { color: var(--gold); margin-top: 22px; font-weight: 500; }
  .faqw { max-width: 780px; }
  .faqi { border-radius: 14px; margin-bottom: 10px; background: rgba(11,17,24,.6); box-shadow: inset 0 0 0 1px var(--line); }
  .faqi[open] { box-shadow: inset 0 0 0 1px rgba(217,184,120,.5); }
  .faqi summary { cursor: pointer; font-weight: 600; list-style: none; padding: 18px 22px; min-height: 56px; display: flex; align-items: center; }
  .faqi summary::-webkit-details-marker { display: none; }
  .faqi p { margin: 0; padding: 0 22px 18px; }
</style>
