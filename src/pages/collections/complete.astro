---
// Página carro-chefe: VESPRO™ Editions (coleção completa). Página de vendas própria no mesmo endereço de antes
// (/collections/complete), com schema de Produto, barra de compra fixa e seções de prova e valor.
import Base from '../../layouts/Base.astro';
import WallGrid from '../../components/WallGrid.astro';
import BeforeAfter from '../../components/home/BeforeAfter.astro';
import Community from '../../components/home/Community.astro';
import PayBadges from '../../components/PayBadges.astro';
import { PAGES } from '../../data/pages';
import { SITE } from '../../config';
import { WALLPAPERS, byCollection, preview, showcase, EDITIONS_LABEL, countLabel } from '../../data/wallpapers';
import { PRODUCTS, formatPrice } from '../../../api/_lib/products.js';

const ed = PRODUCTS.complete;
const price = formatPrice(ed.price);
const buy = '/api/checkout?product=complete&back=collections/complete';
const packs = Object.entries(PRODUCTS).filter(([, p]) => p.kind === 'pack').map(([key, p]) => ({ ...p, key, items: byCollection(key) }));
// exclusivas que aparecem no site (as demais só aparecem depois da compra); o site não diz quantas são
const exclusive = WALLPAPERS.filter((w) => w.collection === null);
const inPacks = packs.reduce((s, p) => s + p.items.length, 0);
const separate = packs.reduce((s, p) => s + p.price, 0);
const perWallpaper = (Math.ceil(ed.price / 150) / 100).toFixed(2);   // teto do preço por obra com 150 obras
const savePct = Math.floor((1 - ed.price / separate) * 100);   // economia contra comprar as coleções uma a uma (sem contar as exclusivas)
const pick = (slugs: string[]) => slugs.map((s) => WALLPAPERS.find((w) => w.slug === s)!).filter(Boolean);
// Topo: uma imagem principal e, embaixo, a capa de cada coleção (com o nome), duas exclusivas e o aviso das próximas edições,
// para mostrar o tamanho do Editions de relance
const featured = pick(['supercars-at-the-palm-mansion'])[0];
const COVERS: Record<string, string> = {
  signature: 'portofino-harbour', ocean: 'tall-ship-open-sea', cars: 'black-sports-car-horse-ranch', sporting: 'polo-at-the-mansion',
  animals: 'galloping-horses', winter: 'skiers-snowy-mountain', cities: 'new-york-skyline-toast', 'still-life': 'chess-reflection-water',
  shadows: 'white-horse-and-red-ferrari-noir',
};
const tiles = [
  ...packs.map((p) => ({ label: p.collection, w: pick([COVERS[p.key]])[0] || p.items[0], excl: false })),
  ...pick(['lake-house-golden-hour', 'black-cat-money']).map((w) => ({ label: 'Exclusive', w, excl: true })),
];

const faq = [
  { q: 'What exactly do I get?', a: `Every VESPRO™ wallpaper in full resolution, ${EDITIONS_LABEL} and growing: all ${packs.length} collections plus exclusive paintings you won't find in any collection. The files come organised in folders by collection.` },
  { q: 'Do I get the new editions too?', a: 'Yes. Every new edition we release is added to VESPRO™ Editions at no extra cost, and you get it through the same download link.' },
  { q: 'Is it a subscription?', a: 'No. You pay once and keep the files for life.' },
  { q: 'What resolution are the files?', a: 'Almost all are 4K (3840 × 2160). The Sporting collection is in HD (1672 × 941). They look sharp on 4K monitors, MacBook Retina screens and any 1440p or 1080p display.' },
  { q: 'Which devices do they work on?', a: 'Mac, Windows PCs, laptops and monitors. Ultrawide screens can crop them, and many customers also use them as a phone lock screen.' },
  { q: 'How fast is delivery?', a: 'Instant. Your download buttons appear on the confirmation page right after checkout, and we also send the links to your email.' },
  { q: 'What if I lose the email?', a: 'Go to My downloads, enter the email you bought with, and we send your links again.' },
  { q: 'What if I don\'t like them?', a: 'Email us within 14 days of purchase and we refund you in full. No questions asked.' },
  { q: 'Can I use them commercially?', a: 'The standard license covers your own devices. For products, stores or apps, ask us about a commercial license.' },
  { q: 'How do I pay?', a: 'Checkout is handled by Stripe. You can pay with major cards and, where available, Apple Pay or Google Pay. We never see your card number.' },
];

const canonical = new URL(PAGES.complete.path, SITE.url).href;
const productLd = {
  '@context': 'https://schema.org', '@type': 'Product',
  name: 'VESPRO Editions: The Complete Collection',
  description: `${EDITIONS_LABEL} VESPRO impasto oil painting wallpapers, every collection, plus every new edition. One-time payment, instant download.`,
  image: [featured, ...tiles.slice(0, 2).map((x) => x.w)].map((w) => new URL(preview(w), SITE.url).href),
  brand: { '@type': 'Brand', name: 'VESPRO' },
  sku: 'vespro-editions',
  offers: { '@type': 'Offer', price: (ed.price / 100).toFixed(2), priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: canonical },
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base page={PAGES.complete} pageType="collection" image={preview(featured)} jsonLd={[productLd, faqLd]}>

  <!-- Topo: no celular a imagem vem primeiro (como página de produto); no computador, texto à esquerda e mosaico à direita -->
  <section class="ed-hero">
    <div class="wrap ed-hero__in">
      <div class="ed-hero__art">
        <figure class="ed-art__main">
          <img src={preview(featured, 800)} alt={`${featured.title}, one of the VESPRO™ Editions oil painting wallpapers`} width="800" height="450" loading="eager" fetchpriority="high" decoding="async" />
          <figcaption>{EDITIONS_LABEL} wallpapers · {packs.length} collections</figcaption>
        </figure>
        <ul class="ed-art__tiles" aria-label="Collections included">
          {tiles.map((x) => (
            <li class:list={[{ 'is-excl': x.excl }]}><img src={preview(x.w, 400)} alt="" width="400" height="225" loading="eager" decoding="async" /><span>{x.label}</span></li>
          ))}
          <li class="ed-art__new"><b>+</b><span>New editions, free</span></li>
        </ul>
      </div>
      <div class="ed-hero__txt">
        <p class="eyebrow">The Complete Collection</p>
        <h1>VESPRO™ <em class="serif">Editions</em></h1>
        <p class="lead">Every oil painting wallpaper we have ever made, in one download. Every new edition free, for life.</p>
        <div class="ed-price">
          <b>{price}</b>
          <span class="ed-price__save">Save {savePct}%</span>
        </div>
        <p class="ed-price__note"><s>{formatPrice(separate)}</s> if you buy the {packs.length} collections separately · under ${perWallpaper} per wallpaper</p>
        <div class="ed-cta" data-ed-cta>
          <a class="btn ed-cta__buy" href={buy} data-checkout data-track="ClickBuy" data-track-value={(ed.price / 100).toFixed(2)} data-track-name={ed.name}>Get VESPRO™ Editions</a>
          <button type="button" class="btn btn--ghost" data-add-to-cart="complete">+ Cart</button>
        </div>
        <div class="ed-pay"><PayBadges /></div>
        <p class="ed-trust">One-time payment · Instant download · 14-day money-back guarantee</p>
      </div>
    </div>
  </section>

  <!-- Números -->
  <section class="wrap ed-stats" aria-label="At a glance">
    <div><b>{EDITIONS_LABEL}</b><span>oil painting wallpapers</span></div>
    <div><b>{packs.length}</b><span>collections in one</span></div>
    <div><b>4K</b><span>most files 3840 × 2160</span></div>
    <div><b>Free</b><span>future editions</span></div>
    <div><b>Once</b><span>pay one time, keep forever</span></div>
  </section>

  <!-- O que tem dentro -->
  <section class="section">
    <div class="wrap">
      <div class="center">
        <p class="eyebrow">What's inside</p>
        <h2>Every collection, <em class="serif">one download</em></h2>
        <p class="lead" style="margin-inline:auto">{packs.length} collections painted in thick impasto, plus the paintings you can only get here.</p>
      </div>
      <div class="ed-cols">
        {packs.map((p) => (
          <a class="ed-col" href={p.page}>
            <div class="ed-col__img">{p.items.slice(0, 4).map((w) => <img src={preview(w, 400)} alt="" width="400" height="225" loading="lazy" decoding="async" />)}</div>
            <p class="ed-col__brand">VESPRO™</p>
            <h3>{p.collection}</h3>
            <p class="ed-col__meta">{p.edition} · {countLabel(p.items.length)} wallpapers{p.hd ? ' · HD' : ''}</p>
            <p class="ed-col__blurb">{p.blurb.replace(/ (4K|HD) wallpapers\.$/, '').replace(/, in 4K\.$/, '.')}</p>
          </a>
        ))}
        <div class="ed-col ed-col--excl">
          <div class="ed-col__img">{exclusive.slice(0, 4).map((w) => <img src={preview(w, 400)} alt="" width="400" height="225" loading="lazy" decoding="async" />)}</div>
          <p class="ed-col__brand">Only in VESPRO™ Editions</p>
          <h3>Exclusive paintings</h3>
          <p class="ed-col__meta">Not sold in any collection</p>
          <p class="ed-col__blurb">Paintings never sold on their own, including some you only get to see after purchase.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparação de valor -->
  <section class="section">
    <div class="wrap ed-value">
      <div class="center">
        <p class="eyebrow">The smart choice</p>
        <h2>More than every collection <em class="serif">combined</em></h2>
      </div>
      <div class="ed-table" role="table" aria-label="Collections one by one compared with VESPRO™ Editions">
        <div class="ed-table__row ed-table__head" role="row">
          <span role="columnheader"></span><span role="columnheader">Collections one by one</span><span role="columnheader">VESPRO™ Editions</span>
        </div>
        <div class="ed-table__row" role="row"><span role="rowheader">Price</span><span role="cell">{formatPrice(separate)}</span><span role="cell"><b>{price}</b></span></div>
        <div class="ed-table__row" role="row"><span role="rowheader">Wallpapers</span><span role="cell">{inPacks}</span><span role="cell"><b>{EDITIONS_LABEL}</b></span></div>
        <div class="ed-table__row" role="row"><span role="rowheader">Exclusive paintings</span><span role="cell">None</span><span role="cell"><b>Included</b></span></div>
        <div class="ed-table__row" role="row"><span role="rowheader">Future editions</span><span role="cell">Paid separately</span><span role="cell"><b>Included, free</b></span></div>
        <div class="ed-table__row" role="row"><span role="rowheader">Checkouts</span><span role="cell">{packs.length}</span><span role="cell"><b>1</b></span></div>
      </div>
      <p class="center" style="margin-top:28px">
        <a class="btn" href={buy} data-checkout data-track="ClickBuy" data-track-value={(ed.price / 100).toFixed(2)} data-track-name={ed.name}>Get all {EDITIONS_LABEL} for {price}</a>
      </p>
    </div>
  </section>

  <BeforeAfter href={buy} checkout label={`Get VESPRO™ Editions for ${price}`} />

  <!-- Como funciona -->
  <section class="section">
    <div class="wrap">
      <div class="center">
        <p class="eyebrow">How it works</p>
        <h2>On your screen in <em class="serif">two minutes</em></h2>
      </div>
      <ol class="ed-steps">
        <li><b>1</b><h3>Check out once</h3><p>Pay {price} with Stripe. Card, Apple Pay or Google Pay where available.</p></li>
        <li><b>2</b><h3>Download instantly</h3><p>Your download buttons appear right away, and the links land in your inbox too.</p></li>
        <li><b>3</b><h3>Set it and enjoy</h3><p>Pick a painting, set it as your wallpaper and change it whenever your mood does.</p></li>
      </ol>
    </div>
  </section>

  <Community />

  <!-- Perguntas -->
  <section class="section" id="faq">
    <div class="wrap ed-faq">
      <h2 class="center">Questions about <em class="serif">VESPRO™ Editions</em></h2>
      {faq.map((f) => (<details class="ed-faq__i"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>
  </section>

  <!-- Chamada final com a garantia -->
  <section class="section">
    <div class="wrap ed-guar">
      <div class="ed-guar__seal" aria-hidden="true">14<small>DAYS</small></div>
      <div>
        <h2>Love them, or get your <em class="serif">money back</em></h2>
        <p>If the wallpapers aren't what you expected, email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> within 14 days and we refund you in full. No forms, no questions.</p>
        <a class="btn ed-guar__btn" href={buy} data-checkout data-track="ClickBuy" data-track-value={(ed.price / 100).toFixed(2)} data-track-name={ed.name}>Get all {EDITIONS_LABEL} for {price}</a>
      </div>
    </div>
  </section>

  <!-- Barra de compra fixa (aparece quando o botão do topo sai da tela) -->
  <div class="ed-bar" data-ed-bar hidden>
    <div class="wrap ed-bar__in">
      <span><b>VESPRO™ Editions</b><small>{EDITIONS_LABEL} wallpapers · {price}</small></span>
      <a class="btn" href={buy} data-checkout data-track="ClickBuy" data-track-value={(ed.price / 100).toFixed(2)} data-track-name={ed.name}>Get it</a>
    </div>
  </div>

  <script is:inline src="/js/home.js" defer></script>
  <script is:inline>
    // roda depois da página inteira existir (o rodapé vem depois deste script)
    document.addEventListener('DOMContentLoaded', function () {
      var cta = document.querySelector('[data-ed-cta]'), bar = document.querySelector('[data-ed-bar]'), foot = document.querySelector('.ftr');
      if (!cta || !bar || !('IntersectionObserver' in window)) return;
      var above = true, footVisible = false;
      var sync = function () { bar.hidden = above || footVisible; };
      new IntersectionObserver(function (es) { above = es[0].isIntersecting || es[0].boundingClientRect.top > 0; sync(); }).observe(cta);
      if (foot) new IntersectionObserver(function (es) { footVisible = es[0].isIntersecting; sync(); }).observe(foot);
    });
  </script>
</Base>

<style>
  .ed-hero { position: relative; overflow: hidden; padding: 56px 0 40px; }
  .ed-hero::before { content: ''; position: absolute; inset: -20% 30% auto -10%; height: 520px; z-index: 0;
    background: radial-gradient(ellipse at center, hsl(214 60% 28% / .45), transparent 65%); filter: blur(30px); }
  .ed-hero__in { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1.05fr; gap: 48px; align-items: center; }
  .ed-hero h1 { font-size: clamp(2.6rem, 6.4vw, 5.2rem); letter-spacing: -0.03em; margin-bottom: .25em; }
  .ed-hero__txt { grid-column: 1; grid-row: 1; }
  .ed-price { display: flex; align-items: center; gap: 12px; margin: 22px 0 8px; }
  .ed-price b { font-size: 2.8rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1; }
  .ed-price__save { padding: 4px 10px; border-radius: 999px; font-size: .74rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: #eaf6ee; background: #2c6a45; }
  .ed-price__note { font-size: .86rem; line-height: 1.5; color: var(--muted); margin: 0 0 20px; }
  .ed-price__note s { color: var(--soft); }
  .ed-cta { display: flex; gap: 10px; flex-wrap: wrap; }
  .ed-cta__buy { flex: 1; min-width: 220px; justify-content: center; padding-block: 17px; font-size: .92rem; }
  .ed-pay { margin-top: 14px; }
  .ed-trust { font-size: .8rem; color: var(--muted); margin: 12px 0 0; }
  .ed-hero__art { grid-column: 2; grid-row: 1; display: grid; gap: 8px; }
  .ed-art__main { position: relative; margin: 0; border-radius: 14px; overflow: hidden;
    box-shadow: 0 0 0 1px rgba(217,184,120,.6), 0 40px 80px -30px rgba(0,0,0,.9); }
  .ed-art__main img { display: block; width: 100%; aspect-ratio: 16/9; object-fit: cover; }
  .ed-art__main figcaption { position: absolute; left: 12px; bottom: 12px; padding: 6px 12px; border-radius: 999px; font-size: .76rem; font-weight: 700;
    letter-spacing: .03em; color: #10151c; background: var(--gold); box-shadow: 0 6px 16px -6px rgba(0,0,0,.7); }
  .ed-art__tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .ed-art__tiles li { position: relative; aspect-ratio: 16/11; border-radius: 9px; overflow: hidden; box-shadow: 0 0 0 1px rgba(255,255,255,.12); }
  .ed-art__tiles img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ed-art__tiles li::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(4,7,12,.9), rgba(4,7,12,0) 62%); }
  .ed-art__tiles span { position: absolute; z-index: 1; left: 7px; right: 6px; bottom: 6px; font-size: .64rem; font-weight: 700; line-height: 1.15; color: #fff; }
  .ed-art__tiles li.is-excl { box-shadow: 0 0 0 1px rgba(217,184,120,.6); }
  .ed-art__tiles li.is-excl span { color: var(--gold); text-transform: uppercase; letter-spacing: .08em; font-size: .58rem; }
  .ed-art__tiles .ed-art__new { display: grid; place-content: center; justify-items: center; gap: 2px; text-align: center; padding: 6px;
    background: rgba(217,184,120,.1); box-shadow: inset 0 0 0 1px rgba(217,184,120,.5); }
  .ed-art__tiles .ed-art__new::after { display: none; }
  .ed-art__new b { font-size: 1.3rem; line-height: 1; color: var(--gold); }
  .ed-art__new span { position: static; color: var(--soft); font-weight: 600; }

  .ed-stats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; border-radius: 14px; overflow: hidden; background: var(--line); box-shadow: 0 0 0 1px var(--line); }
  .ed-stats div { background: rgba(11,17,24,.92); padding: 20px 14px; text-align: center; display: grid; gap: 4px; }
  .ed-stats b { font-size: 1.6rem; font-weight: 600; color: var(--gold); }
  .ed-stats span { font-size: .8rem; color: var(--muted); }

  .ed-cols { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 28px 22px; margin-top: 36px; }
  .ed-col { display: block; text-decoration: none; border-radius: 14px; padding: 10px 10px 18px; background: rgba(11,17,24,.6); box-shadow: inset 0 0 0 1px var(--line); transition: box-shadow .2s; }
  a.ed-col:hover { box-shadow: inset 0 0 0 1px rgba(217,184,120,.55); }
  .ed-col__img { display: grid; grid-template-columns: 1fr 1fr; gap: 3px; border-radius: 10px; overflow: hidden; margin-bottom: 14px; }
  .ed-col__img img { width: 100%; aspect-ratio: 16/10; object-fit: cover; }
  .ed-col__brand { font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin: 0 6px; }
  .ed-col h3 { margin: 2px 6px 2px; font-size: 1.2rem; }
  .ed-col__meta { font-size: .8rem; color: var(--gold); margin: 0 6px 8px; }
  .ed-col__blurb { font-size: .88rem; margin: 0 6px; }
  .ed-col--excl { box-shadow: inset 0 0 0 1px rgba(217,184,120,.55); background: linear-gradient(160deg, rgba(217,184,120,.08), rgba(11,17,24,.6)); }
  .ed-col--excl .ed-col__brand { color: var(--gold); }

  .ed-value { max-width: 820px; }
  .ed-table { margin-top: 28px; border-radius: 14px; overflow: hidden; box-shadow: inset 0 0 0 1px var(--line); }
  .ed-table__row { display: grid; grid-template-columns: 1.1fr 1fr 1fr; border-top: 1px solid var(--line); }
  .ed-table__row:first-child { border-top: 0; }
  .ed-table__row span { padding: 14px 18px; color: var(--soft); font-size: .95rem; }
  .ed-table__row span:last-child { background: rgba(217,184,120,.08); color: var(--fg); }
  .ed-table__row span[role='rowheader'] { color: var(--muted); }
  .ed-table__head span { font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; color: var(--muted); }
  .ed-table__head span:last-child { color: var(--gold); }

  .ed-steps { list-style: none; padding: 0; margin: 36px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .ed-steps li { border-radius: 14px; padding: 24px; background: rgba(11,17,24,.6); box-shadow: inset 0 0 0 1px var(--line); }
  .ed-steps b { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--gold); color: #060a10; font-weight: 700; margin-bottom: 14px; }
  .ed-steps h3 { margin-bottom: .4em; }
  .ed-steps p { margin: 0; font-size: .92rem; }

  .ed-guar { max-width: 820px; display: flex; gap: 28px; align-items: center; border-radius: 18px; padding: 30px; background: rgba(11,17,24,.7); box-shadow: inset 0 0 0 1px rgba(217,184,120,.45); }
  .ed-guar__seal { flex-shrink: 0; width: 110px; height: 110px; border-radius: 50%; display: grid; place-content: center; text-align: center; font-size: 2.4rem; font-weight: 700; line-height: 1;
    color: var(--gold); box-shadow: inset 0 0 0 2px var(--gold), inset 0 0 0 7px rgba(6,10,16,1), inset 0 0 0 8px rgba(217,184,120,.5); }
  .ed-guar__seal small { font-size: .7rem; letter-spacing: .2em; margin-top: 4px; }
  .ed-guar h2 { font-size: clamp(1.5rem, 3vw, 2.1rem); }
  .ed-guar p { margin: 0; }
  .ed-guar__btn { margin-top: 18px; }

  .ed-faq { max-width: 780px; }
  .ed-faq__i { border-radius: 14px; margin-bottom: 10px; background: rgba(11,17,24,.6); box-shadow: inset 0 0 0 1px var(--line); }
  .ed-faq__i[open] { box-shadow: inset 0 0 0 1px rgba(217,184,120,.5); }
  .ed-faq__i summary { cursor: pointer; font-weight: 600; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 22px; min-height: 56px; }
  .ed-faq__i summary::after { content: '+'; color: var(--muted); font-size: 1.3rem; line-height: 1; transition: transform .2s; }
  .ed-faq__i[open] summary::after { transform: rotate(45deg); color: var(--gold); }
  .ed-faq__i summary::-webkit-details-marker { display: none; }
  .ed-faq__i p { margin: 0; padding: 0 22px 18px; }



  .ed-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 25; background: rgba(6,10,16,.94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-top: 1px solid var(--line); }
  .ed-bar[hidden] { display: none; }
  .ed-bar__in { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 0; }
  .ed-bar b { display: block; font-weight: 600; }
  .ed-bar small { color: var(--muted); font-size: .8rem; }
  .ed-bar .btn { padding: 12px 26px; }

  @media (max-width: 900px) {
    .ed-hero__in { grid-template-columns: minmax(0, 1fr); gap: 22px; }
    .ed-hero__art, .ed-hero__txt { grid-column: 1; }
    .ed-hero__txt { grid-row: 2; }
    .ed-hero__art { width: 100%; max-width: 560px; margin-inline: auto; gap: 6px; }
