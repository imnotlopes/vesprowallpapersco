---
// Layout base: SEO completo (title, description, canonical, robots, Open Graph, JSON-LD),
// fontes sem bloquear a tela, pixel do Meta, Microsoft Clarity e rastreamento do funil (/js/track.js).
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cart from '../components/Cart.astro';
import { SITE } from '../config';
import type { PageMeta } from '../data/pages';
import { WALLPAPERS, preview } from '../data/wallpapers';

interface Props {
  page: PageMeta;
  image?: string;
  pageType?: string;          // vai para o Clarity e para os eventos do funil (home, hub, catalog, legal…)
  jsonLd?: Record<string, unknown>[];
  footerNote?: string;
  floaters?: boolean;         // telas flutuantes nas margens (public/js/floaters.js)
}
const { page, image = SITE.ogImage, pageType = 'page', jsonLd = [], footerNote, floaters = true } = Astro.props;
const floatImgs = floaters ? JSON.stringify(WALLPAPERS.map((w) => preview(w, 400))) : '';
const canonical = new URL(page.path, SITE.url).href.replace(/\/$/, page.path === '/' ? '/' : '');
const ogImage = new URL(image, SITE.url).href;
const FONTS = 'https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&display=swap';
const ld = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: SITE.url, logo: new URL('/img/brand/icon-512.png', SITE.url).href, email: SITE.email, sameAs: [SITE.instagram.url, SITE.tiktok.url, SITE.facebook.url].filter(Boolean) },
  ...(page.path === '/' ? [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url }] : []),
  ...jsonLd,
];
---
<!doctype html>
<html lang={SITE.locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <script is:inline define:vars={{ pixelId: SITE.metaPixelId, clarityId: SITE.clarityId, pageType }}>
    window.VESPRO = { pixelId, clarityId, pageType };
    // Pixel do Meta e Clarity: a fila (fbq, clarity) existe desde já, então nenhum evento se perde; os scripts deles
    // (cerca de 270 KB) só são baixados 1,5 s depois do carregamento, para não atrasar a imagem principal no celular.
    var later = [];
    if (pixelId) {
      !function(f){if(f.fbq)return;var n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[]}(window);
      fbq('init', pixelId); fbq('track', 'PageView');
      later.push('https://connect.facebook.net/en_US/fbevents.js');
    }
    if (clarityId) {
      window.clarity = window.clarity || function(){(window.clarity.q=window.clarity.q||[]).push(arguments)};
      window.clarity('set', 'site', 'brand');
      window.clarity('set', 'page_type', pageType);
      later.push('https://www.clarity.ms/tag/' + clarityId);
    }
    var loadLater = function () { setTimeout(function () { later.forEach(function (src) { var s = document.createElement('script'); s.async = true; s.src = src; document.head.appendChild(s); }); }, 1500); };
    if (document.readyState === 'complete') loadLater(); else window.addEventListener('load', loadLater);
  </script>
  <title>{page.title}</title>
  <meta name="description" content={page.description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={page.indexable ? 'index,follow,max-image-preview:large' : 'noindex,follow'} />
  <meta name="theme-color" content="#060a10" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href="/img/brand/favicon-32.png" />
  <link rel="apple-touch-icon" href="/img/brand/apple-touch-icon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={page.title} />
  <meta property="og:description" content={page.description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" as="style" href={FONTS} />
  <link rel="stylesheet" href={FONTS} media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href={FONTS} /></noscript>
  {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</head>
<body data-page-type={pageType}>
  <Header />
  <main>
    {floaters && <div class="flt" aria-hidden="true" data-floaters={floatImgs}></div>}
    <slot />
  </main>
  <Footer note={footerNote} />
  <Cart />
  <script is:inline src="/js/track.js" defer></script>
  <script is:inline src="/js/cart.js" defer></script>
  <script is:inline src="/js/nav.js" defer></script>
  <script is:inline src="/js/protect.js" defer></script>
  {floaters && <script is:inline src="/js/floaters.js" defer></script>}
</body>
</html>
