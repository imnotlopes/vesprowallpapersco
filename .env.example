# Variáveis de ambiente (cole em Vercel → Project → Settings → Environment Variables). Nunca commitar valores reais.

SITE_URL=https://www.vesprowallpapers.com

# Stripe (Developers → API keys / Webhooks). Webhook: https://www.vesprowallpapers.com/api/stripe-webhook
# eventos: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# true se ativar o Stripe Tax (impostos automáticos por país)
STRIPE_AUTOMATIC_TAX=false

# Klaviyo (Settings → API keys → Create Private API Key, escopos: Events = Full, Profiles = Full,
# Subscriptions = Full, Lists = Full). Lista de novidades: Audience → Lists & Segments → ID da lista.
# Remetente, domínio e os e-mails ficam nos fluxos do Klaviyo (ver docs/klaviyo.md).
KLAVIYO_PRIVATE_KEY=pk_...
KLAVIYO_LIST_ID=AbC123

# Links de entrega (pastas do Drive com os arquivos em 4K, "qualquer pessoa com o link")
DELIVERY_LINKS={"free":"https://drive.google.com/...","complete":"https://drive.google.com/...","ocean":"...","cities":"...","winter":"...","animals":"...","cars":"...","still-life":"...","signature":"...","sporting":"...","shadows":"..."}
